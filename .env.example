PORT=4000
NODE_ENV=development

# Supabase — service role stays on this server only. Never put it in Next.js.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated browser origins for the booking app and super admin app.
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001
APP_BOOKING_URL=http://localhost:3000
APP_ADMIN_URL=http://localhost:3001

# Optional SMTP. When unset, emails are logged on the server and stored in email_logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Bookings <bookings@example.com>

# Optional Stripe guest checkout. Leave blank to offer pay-at-property only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Used by npm run seed:admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
